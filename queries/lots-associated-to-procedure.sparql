# Retrieve the lots associated to a specific procedure.
# Returns: publication number, lot URI, procedure identifier, lot identifier, lot title, and main CPV code.
# Change the procedure identifier below to query a different procedure.
# ?procedureIdentifier: Procedure identifier
#
# Note: A procedure can be announced by more than one notice (e.g. an
# original result notice and a later modification); each notice mints its
# own lot node with a distinct URI but the same lot identifier. The
# publication number and lot URI (?lot) are included so each row shows which
# notice it comes from, rather than appearing as identical duplicates. The
# lot title is picked via SAMPLE to collapse titles recorded in more than
# one language.

PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX epo: <http://data.europa.eu/a4g/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?publicationNumber ?lot ?procedureIdentifier ?lotIdentifier (SAMPLE(?lotTitle) AS ?lotTitle) ?lotMainCPVCode ?lotMainCPV

WHERE {

  # Change this to the procedure you want to look up
  VALUES (?procedureIdentifier) {
    ("c9fc740a-2b2e-42a9-9fee-fb4965914b6b")
  }

  GRAPH ?g {
    # Get procedure and its lots
    ?procedure a epo:Procedure ;
               adms:identifier / skos:notation ?procedureIdentifier ;
               epo:hasProcurementScopeDividedIntoLot ?lot .

    # Link the notice that announces this procedure
    ?notice a epo:Notice ;
            epo:hasNoticePublicationNumber ?publicationNumber ;
            epo:refersToProcedure ?procedure .

    # Get lot details and CPV classification
    ?lot adms:identifier / skos:notation ?lotIdentifier ;
         epo:hasPurpose / epo:hasMainClassification ?lotMainCPVUri .

    OPTIONAL { ?lot dcterms:title ?lotTitle . }
  }

  # Resolve CPV code and label
  ?lotMainCPVUri dc:identifier ?lotMainCPVCode ;
                 skos:prefLabel ?lotMainCPV .
  FILTER(lang(?lotMainCPV) = "en")
}
GROUP BY ?publicationNumber ?lot ?procedureIdentifier ?lotIdentifier ?lotMainCPVCode ?lotMainCPV
ORDER BY ASC(?lotIdentifier)
