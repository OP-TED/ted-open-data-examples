# Retrieves the count of notices per buyer for a specific date.
# Returns: buyer name, buyer country, and the notice count, ordered by highest count.
# Change the publication date as per your requirements.
#
# Groups by buyer name AND country to avoid merging different real-world
# buyers that happen to share a generic name (e.g. "Ministry of Defence"
# exists as a distinct buyer in both Cyprus and the Netherlands). Buyers
# within the same country with the same name are considered as one entity.
#
# Known limitation: buyers whose legal name is recorded in more than one
# language (e.g. Belgian federal bodies published as both "Federale Politie"
# and "Police Fédérale") are still counted as separate buyers, splitting
# their notice count across rows. This cannot be fixed by grouping on the
# organization URI instead, because the data pipeline mints a new
# organization URI per notice rather than reusing a stable URI for the
# same real-world buyer across notices -- there is currently no stable
# cross-notice identifier for an organization in the data. See known
# issues and limitations:
# https://docs.ted.europa.eu/ODS/latest/querying/known_issues.html

PREFIX epo: <http://data.europa.eu/a4g/ontology#>
PREFIX m8g: <http://data.europa.eu/m8g/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?buyerName ?buyerCountry (COUNT(DISTINCT ?publicationNumber) AS ?noticeCount)
WHERE {
  FILTER (?publicationDate = "2025-07-29"^^xsd:date)

  GRAPH ?g {
    ?notice a epo:Notice ;
            epo:hasNoticePublicationNumber ?publicationNumber ;
            epo:hasPublicationDate ?publicationDate ;
            epo:refersToRole ?buyer .

    ?buyer a epo:Buyer ;
           epo:playedBy ?organization .

    ?organization epo:hasLegalName ?buyerName ;
                  m8g:registeredAddress ?regAdd .

    ?regAdd epo:hasCountryCode ?buyerCountryUri .
  }

  # Resolve country label in English
  ?buyerCountryUri skos:prefLabel ?buyerCountry .
  FILTER (lang(?buyerCountry) = "en")
}
GROUP BY ?buyerName ?buyerCountry
ORDER BY DESC(?noticeCount)
